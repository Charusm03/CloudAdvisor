# Backend settings (all optional; defaults shown)
FLASK_DEBUG=0
PORT=5000
CORS_ORIGINS=http://localhost:5173
RANKING_MODE=cost            # cost (default) | weighted
INCLUDE_INGRESS=0            # 1 = also bill inbound data
PRICING_STALE_AFTER_DAYS=30
RATE_LIMIT_REQUESTS=120      # per minute per IP, 0 = off
